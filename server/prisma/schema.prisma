generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  passwordHash     String
  fullName         String
  phone            String?
  status           String              @default("ACTIVE")
  assignedBalance  Float               @default(0)
  availableBalance Float               @default(0)
  currency         String              @default("USD")
  lastLogin        DateTime?
  lastActivity     DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  trades           Trade[]
  withdrawals      WithdrawalRequest[]
  balanceHistory   BalanceHistory[]
}

model Trade {
  id                String    @id @default(cuid())
  userId            String
  asset             String
  direction         String
  entryPrice        Float
  exitPrice         Float?
  quantity          Float
  leverage          Int       @default(1)
  margin            Float?
  profitLoss        Float?
  profitLossPercent Float?
  status            String    @default("OPEN")
  notes             String?
  createdById       String?
  openedAt          DateTime  @default(now())
  executedAt        DateTime  @default(now())
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WithdrawalRequest {
  id           String    @id @default(cuid())
  userId       String
  amount       Float
  method       String
  destination  String
  status       String    @default("PENDING")
  userNotes    String?
  adminNotes   String?
  requestedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BalanceHistory {
  id            String   @id @default(cuid())
  userId        String
  performedById String
  action        String
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  reason        String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
